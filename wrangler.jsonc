{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cms-hoidapluat",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hoidapluat-cms","database_id": "19b87330-af56-4492-bb38-6de2b2bf2edc",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "hoidapluat-cms","preview_bucket_name": "hoidapluat-cms",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
